{
  "name": "wandertable",
  "version": "0.1.1",
  "description": "High-performance virtualized grid/spreadsheet library",
  "type": "module",
  "main": "dist/wandertable.cjs",
  "module": "dist/wandertable.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/wandertable.js",
      "require": "./dist/wandertable.cjs"
    },
    "./style.css": "./dist/style.css",
    "./global": "./dist/wandertable.global.js",
    "./umd": "./dist/wandertable.umd.js"
  },
  "unpkg": "dist/wandertable.global.js",
  "jsdelivr": "dist/wandertable.global.js",
  "files": ["dist"],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  },
  "license": "MIT"
}
